{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `next build` rewrites `incremental` back to true whenever it is absent
    // (next/dist/lib/typescript/writeConfigurationDefaults.js), so it is set
    // rather than fought. `tsBuildInfoFile` puts the cache it produces under
    // `.next/`, which `.gitignore` already covers -- left at its default it
    // lands as an untracked `storefront/tsconfig.tsbuildinfo` that every
    // `scripts/validate` run regenerates, which is what the reference
    // implementation carries today.
    "incremental": true,
    "tsBuildInfoFile": "./.next/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
