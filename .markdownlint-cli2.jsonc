{
  // Layout checking for this repository's Markdown.
  // Wording is a review concern; see the documentation standard.
  "config": {
    "default": true,

    // Prose wraps at 80 columns by convention, but a table row or a pinned
    // action SHA cannot. A hard limit would force a broken table or a
    // truncated SHA.
    "MD013": false,

    // Decision records deliberately repeat "## Decision" and "## Rationale".
    // Duplicates within one document still fail.
    "MD024": { "siblings_only": true },

    // The generated baseline is HTML comment markers plus a table. Inline HTML
    // is how a marker-delimited region is expressed at all.
    "MD033": false,

    // A README may open with a heading that matches its directory name.
    "MD041": false
  },
  "globs": ["**/*.md"],
  // A bare "node_modules" matches only a top-level directory of that name --
  // not a nested one (e.g. a workspace's own node_modules, or a package
  // manager's own dependency-conflict copy), and not a build output
  // directory. Both are already excluded from git via .gitignore, but this
  // tool globs the filesystem rather than reading git, so it walked into a
  // vendored README the first time a workspace produced a nested
  // node_modules. Four explicit globs, matching the reference implementation.
  "ignores": ["node_modules/**", "**/node_modules/**", "**/.next/**", "**/.medusa/**"]
}
